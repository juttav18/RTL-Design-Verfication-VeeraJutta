module binary_to_gray (
    input clk, rst,             // Clock and reset
    output reg [2:0] gray_out   // 3-bit Gray code output
);

    reg [2:0] binary; // 3-bit register to store binary input

    // 3-bit Binary Counter
    always @(posedge clk or posedge rst) begin
        if (rst)
            binary <= 3'b000;
        else
            binary <= binary + 1;
    end

    // Combinational Logic for Gray Code Conversion
    always @(*) begin
        gray_out[2] = binary[2];                    // MSB remains the same
        gray_out[1] = binary[2] ^ binary[1];        // XOR of B2 and B1
        gray_out[0] = binary[1] ^ binary[0];        // XOR of B1 and B0
    end

endmodule
