module binary_to_gray (
    input [2:0] binary,  // 3-bit Binary Input
    output [2:0] gray    // 3-bit Gray Code Output
);
    assign gray[2] = binary[2];                   // MSB remains the same
    assign gray[1] = binary[2] ^ binary[1];       // XOR of B2 and B1
    assign gray[0] = binary[1] ^ binary[0];       // XOR of B1 and B0
endmodule
