module gray_to_binary (
    input [3:0] gray,   // 4-bit Gray Code Input
    output [3:0] binary // 4-bit Binary Output
);
    assign binary[3] = gray[3];                   // MSB remains the same
    assign binary[2] = gray[3] ^ gray[2];         // XOR of G3 and G2
    assign binary[1] = binary[2] ^ gray[1];       // XOR of B2 and G1
    assign binary[0] = binary[1] ^ gray[0];       // XOR of B1 and G0
endmodule
